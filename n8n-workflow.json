    },
    {
      "id": "ca_cancel_booking",
      "name": "CA Cancel booking",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [
        1000,
        600
      ],
      "parameters": {
        "base": {
          "__rl": true,
