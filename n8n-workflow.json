      ],
      "parameters": {
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "appYOUR_BASE_ID"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "Bookings"
        },
        "operation": "list",
        "options": {
          "filterByFormula": "AND({Status}='confirmed', {Phone}='{{ $json.args.phone }}')"
        }
      }
    },
    {
      "id": "ca_merge_context",
      "name": "CA Merge context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        400,
        600
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "m11",
