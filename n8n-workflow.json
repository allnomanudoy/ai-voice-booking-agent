{
  "name": "VAPI Booking Starter",
  "nodes": [
    {
      "id": "a1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-400, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "vapi-booking",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "vapi-booking"
    },
    {
      "id": "a2",
      "name": "Is tool-calls event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [-200, 0],
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": false, "typeValidation": "strict"},
          "conditions": [
            {
              "leftValue": "={{ $json.message.message.type }}",
              "rightValue": "tool-calls",
              "operator": {"type": "equal", "operation": "equal"}
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a3",
      "name": "Switch by tool",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.message.message.toolCallList[0].function.name }}",
        "rules": {
          "values": [
            {"outputKey": "check_availability", "value1": "check_availability"},
            {"outputKey": "book", "value1": "book_room"},
            {"outputKey": "modify_or_cancel", "value1": "modify_booking"}
          ]
        }
      }
    },
    {
      "id": "b1",
      "name": "Stub: availability",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [200, -100],
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "s1", "name": "success", "value": true, "type": "boolean"},
            {"id": "s2", "name": "spoken_response", "value": "TODO: call Airtable and replace this sentence.", "type": "string"}
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b2",
      "name": "Stub: book",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [200, 0],
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "s3", "name": "success", "value": true, "type": "boolean"},
            {"id": "s4", "name": "spoken_response", "value": "TODO: idempotency check + Airtable Create, then confirm.", "type": "string"}
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b3",
      "name": "Stub: modify/cancel",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [200, 100],
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "s5", "name": "success", "value": true, "type": "boolean"},
            {"id": "s6", "name": "spoken_response", "value": "TODO: search booking by phone, then Airtable Update.", "type": "string"}
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c1",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [420, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ {\n  \"results\": [ {\n    \"toolCallId\": \"{{ $json.message.message.toolCallList[0].id }}\",\n    \"result\": {\n      \"success\": {{ $json.success }},\n      \"spoken_response\": \"{{ $json.spoken_response }}\"\n    }\n  } ]\n} }"
      }
    }
  ],
  "connections": {
    "Webhook": {"main": [[{"node": "Is tool-calls event?", "type": "main", "index": 0}]]},
    "Is tool-calls event?": {"main": [
      [{"node": "Switch by tool", "type": "main", "index": 0}],
      []
    ]},
    "Switch by tool": {"main": [
      [{"node": "Stub: availability", "type": "main", "index": 0}],
      [{"node": "Stub: book", "type": "main", "index": 0}],
      [{"node": "Stub: modify/cancel", "type": "main", "index": 0}],
      []
    ]},
    "Stub: availability": {"main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]},
    "Stub: book": {"main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]},
    "Stub: modify/cancel": {"main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"},
  "version": "1"
}
