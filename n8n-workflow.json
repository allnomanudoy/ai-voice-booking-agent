      }
    },
    {
      "id": "mo_confirm",
      "name": "MO Confirm",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        300
      ],
      "parameters": {
        "jsCode": "const ctx = $json.ctx || {};\nconst note = $json.note || '';\nreturn [{ json: { success: true, toolCallId: ctx.toolCallId, booking_id: $json.id || '',\n  spoken_response: `Your booking is updated.${note} Anything else I can help with?` } }];"
      }
    },
