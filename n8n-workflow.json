      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        600
      ],
      "parameters": {
        "jsCode": "const ctx = $json.ctx || {};\nconst rawArgs = ctx.args || {};\nconst args = typeof rawArgs === 'string' ? JSON.parse(rawArgs) : rawArgs;\nconst confirmed = ($json.records || []).filter(r => r.fields && r.fields.Status === 'confirmed');\nif (confirmed.length === 0) {\n  return [{ json: { success: false, toolCallId: ctx.toolCallId,\n    spoken_response: \"I couldn't find a confirmed booking for that number. Could you double-check it?\" } }];\n}\nreturn [{ json: { proceed: true, toolCallId: ctx.toolCallId, bookingRecId: confirmed[0].id } }];"
      }
    },
    {
      "id": "ca_found?",
      "name": "CA Found?",
      "type": "n8n-nodes-base.if",
